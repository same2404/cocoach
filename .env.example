# CoCoach – Umgebungsvariablen
# Kopiere diese Datei als `.env` und trage deine Werte ein.
# Die Werte sind privat – niemals ins GitHub-Repo laden!

# API-Sicherheit (für lokalen Dev-Server)
FC_AUGGEN_API_SECRET=
VITE_API_SECRET=

# Gemini KI (für Agenten & Spielberichte)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Firebase (Web-Konfiguration)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DB_ID=
FIREBASE_STORAGE=
FIREBASE_SENDER_ID=