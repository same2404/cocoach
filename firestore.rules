rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lesen erlaubt allen (behebt List/Get-Bug bei benannten Datenbanken),
    // Schreiben nur für angemeldete Trainer (gemeinsame Daten).
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}